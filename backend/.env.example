# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-change-this

# Database
DATABASE_URL=sqlite:///trading_bot.db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# Telegram
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
