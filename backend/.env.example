# Bot Settings
TRADE_NOTIONAL_USDT=6.0
DEFAULT_LEVERAGE=10
MAX_SIMULTANEOUS_TRADES=5
MAX_HOLD_HOURS=24
SIGNAL_EXPIRY_HOURS=24