# Codemagic Environment Variables Template
# Copy these to Codemagic Dashboard Settings → Environment Variables
# Create separate groups for each section below

# ============================================================
# GROUP 1: eas_credentials
# ============================================================
EAS_USERNAME=your_expo_username
EAS_PASSWORD=your_expo_password
EAS_TOKEN=your_eas_token_here

# ============================================================
# GROUP 2: codemagic_credentials
# ============================================================
# Generated by: ./build-codemagic-env.sh
ANDROID_KEYSTORE_B64=your_base64_keystore_here
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_ALIAS=trading-bot-key
ANDROID_KEY_PASSWORD=your_key_password

# Notifications
ADMIN_EMAIL=your_email@gmail.com
SLACK_CHANNEL=#builds

# ============================================================
# GROUP 3: google_play_credentials
# ============================================================
# Full service-account.json content as single line
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============================================================
# HOW TO GET THESE VALUES
# ============================================================

# EAS_USERNAME & EAS_PASSWORD
# - Your Expo account credentials
# - Sign up: https://expo.dev

# EAS_TOKEN
# - Run: eas login
# - Then: eas credentials show --platform android
# - Copy the full token

# ANDROID_KEYSTORE_B64
# - Run: base64 mobile/trading-bot.keystore
# - Or: ./build-codemagic-env.sh

# ANDROID_KEYSTORE_PASSWORD & ANDROID_KEY_PASSWORD
# - Set when generating keystore with keytool
# - Save securely!

# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
# - Download from: Google Cloud Console → Service Account → Keys
# - Format: Single line JSON (no newlines)
# - Content: Full JSON file contents

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================

# 1. Run local setup:
#    ./setup-codemagic.sh
#
# 2. Generate credentials:
#    ./build-codemagic-env.sh
#
# 3. Get Google Play service account:
#    https://console.cloud.google.com/iam-admin/serviceaccounts
#
# 4. Add groups to Codemagic:
#    https://codemagic.io/teams/{team_id}/integrations
#
# 5. Start first build:
#    Codemagic → Apps → Start build
